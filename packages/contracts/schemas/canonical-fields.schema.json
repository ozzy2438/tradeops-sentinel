{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canonical-fields.schema.json",
  "title": "Canonical FX field definitions",
  "$defs": {
    "canonicalFields": {
      "type": "object",
      "required": [
        "product_type",
        "settlement_rule_version",
        "base_currency",
        "terms_currency",
        "side",
        "base_amount",
        "terms_amount",
        "quoted_rate",
        "trade_date",
        "value_date",
        "lifecycle_status",
        "counterparty_id",
        "book_id"
      ],
      "properties": {
        "product_type": {
          "$ref": "common.schema.json#/$defs/productType"
        },
        "settlement_rule_version": {
          "$ref": "common.schema.json#/$defs/settlementRuleVersion"
        },
        "base_currency": {
          "$ref": "common.schema.json#/$defs/currency"
        },
        "terms_currency": {
          "$ref": "common.schema.json#/$defs/currency"
        },
        "side": {
          "$ref": "common.schema.json#/$defs/side"
        },
        "base_amount": {
          "$ref": "common.schema.json#/$defs/decimalAmount"
        },
        "terms_amount": {
          "$ref": "common.schema.json#/$defs/decimalAmount"
        },
        "quoted_rate": {
          "$ref": "common.schema.json#/$defs/decimalRate"
        },
        "trade_date": {
          "type": "string",
          "format": "date"
        },
        "value_date": {
          "type": "string",
          "format": "date"
        },
        "lifecycle_status": {
          "$ref": "common.schema.json#/$defs/lifecycleStatus"
        },
        "counterparty_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "book_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        }
      },
      "unevaluatedProperties": false
    },
    "fieldProvenanceMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_type",
        "settlement_rule_version",
        "base_currency",
        "terms_currency",
        "side",
        "base_amount",
        "terms_amount",
        "quoted_rate",
        "trade_date",
        "value_date",
        "lifecycle_status",
        "counterparty_id",
        "book_id"
      ],
      "properties": {
        "product_type": {
          "allOf": [
            {"$ref": "common.schema.json#/$defs/fieldProvenance"},
            {"properties": {"field_path": {"const": "/payload/product_type"}}}
          ]
        },
        "settlement_rule_version": {
          "allOf": [
            {"$ref": "common.schema.json#/$defs/fieldProvenance"},
            {"properties": {"field_path": {"const": "/payload/settlement_rule_version"}}}
          ]
        },
        "base_currency": {
          "allOf": [
            {"$ref": "common.schema.json#/$defs/fieldProvenance"},
            {"properties": {"field_path": {"const": "/payload/base_currency"}}}
          ]
        },
        "terms_currency": {
          "allOf": [
            {"$ref": "common.schema.json#/$defs/fieldProvenance"},
            {"properties": {"field_path": {"const": "/payload/terms_currency"}}}
          ]
        },
        "side": {
          "allOf": [
            {"$ref": "common.schema.json#/$defs/fieldProvenance"},
            {"properties": {"field_path": {"const": "/payload/side"}}}
          ]
        },
        "base_amount": {
          "allOf": [
            {"$ref": "common.schema.json#/$defs/fieldProvenance"},
            {"properties": {"field_path": {"const": "/payload/base_amount"}}}
          ]
        },
        "terms_amount": {
          "allOf": [
            {"$ref": "common.schema.json#/$defs/fieldProvenance"},
            {"properties": {"field_path": {"const": "/payload/terms_amount"}}}
          ]
        },
        "quoted_rate": {
          "allOf": [
            {"$ref": "common.schema.json#/$defs/fieldProvenance"},
            {"properties": {"field_path": {"const": "/payload/quoted_rate"}}}
          ]
        },
        "trade_date": {
          "allOf": [
            {"$ref": "common.schema.json#/$defs/fieldProvenance"},
            {"properties": {"field_path": {"const": "/payload/trade_date"}}}
          ]
        },
        "value_date": {
          "allOf": [
            {"$ref": "common.schema.json#/$defs/fieldProvenance"},
            {"properties": {"field_path": {"const": "/payload/value_date"}}}
          ]
        },
        "lifecycle_status": {
          "allOf": [
            {"$ref": "common.schema.json#/$defs/fieldProvenance"},
            {"properties": {"field_path": {"const": "/payload/lifecycle_status"}}}
          ]
        },
        "counterparty_id": {
          "allOf": [
            {"$ref": "common.schema.json#/$defs/fieldProvenance"},
            {"properties": {"field_path": {"const": "/payload/counterparty_id"}}}
          ]
        },
        "book_id": {
          "allOf": [
            {"$ref": "common.schema.json#/$defs/fieldProvenance"},
            {"properties": {"field_path": {"const": "/payload/book_id"}}}
          ]
        }
      }
    }
  }
}
