{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-of-truth-policy.schema.json",
  "title": "FX field source-of-truth and ownership policy",
  "description": "Machine-readable field ownership and trusted-source precedence for the synthetic FX MVP. Conflicts remain evidence and are never silently overwritten.",
  "type": "object",
  "required": ["policy_version", "scope", "field_rules"],
  "properties": {
    "policy_version": {
      "$ref": "common.schema.json#/$defs/semanticVersion"
    },
    "scope": {
      "const": "MVP_SYNTHETIC_FX"
    },
    "field_rules": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/fieldRule"
      },
      "allOf": [
        {"contains": {"properties": {"field_path": {"const": "/payload/product_type"}}, "required": ["field_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"field_path": {"const": "/payload/settlement_rule_version"}}, "required": ["field_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"field_path": {"const": "/payload/base_currency"}}, "required": ["field_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"field_path": {"const": "/payload/terms_currency"}}, "required": ["field_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"field_path": {"const": "/payload/side"}}, "required": ["field_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"field_path": {"const": "/payload/base_amount"}}, "required": ["field_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"field_path": {"const": "/payload/terms_amount"}}, "required": ["field_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"field_path": {"const": "/payload/quoted_rate"}}, "required": ["field_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"field_path": {"const": "/payload/trade_date"}}, "required": ["field_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"field_path": {"const": "/payload/value_date"}}, "required": ["field_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"field_path": {"const": "/payload/lifecycle_status"}}, "required": ["field_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"field_path": {"const": "/payload/counterparty_id"}}, "required": ["field_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"field_path": {"const": "/payload/book_id"}}, "required": ["field_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"field_path": {"const": "/payload/confirmation_status"}}, "required": ["field_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"field_path": {"const": "/payload/booking_status"}}, "required": ["field_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"field_path": {"const": "/linkage/trade_id"}}, "required": ["field_path"]}, "minContains": 1, "maxContains": 1}
      ]
    }
  },
  "$defs": {
    "canonicalFieldPath": {
      "enum": [
        "/payload/product_type",
        "/payload/settlement_rule_version",
        "/payload/base_currency",
        "/payload/terms_currency",
        "/payload/side",
        "/payload/base_amount",
        "/payload/terms_amount",
        "/payload/quoted_rate",
        "/payload/trade_date",
        "/payload/value_date",
        "/payload/lifecycle_status",
        "/payload/counterparty_id",
        "/payload/book_id",
        "/payload/confirmation_status",
        "/payload/booking_status",
        "/linkage/trade_id"
      ]
    },
    "fieldRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_path",
        "owner",
        "trusted_sources",
        "source_precedence",
        "secondary_sources",
        "conflict_outcome"
      ],
      "properties": {
        "field_path": {
          "$ref": "#/$defs/canonicalFieldPath"
        },
        "owner": {
          "enum": [
            "EXECUTION_OR_TRADE_CAPTURE",
            "CONFIRMATION",
            "BOOKING_READ_BACK",
            "LINKAGE_RULE"
          ]
        },
        "trusted_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/sourceSystem"
          }
        },
        "source_precedence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/sourceSystem"
          }
        },
        "secondary_sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/sourceSystem"
          }
        },
        "conflict_outcome": {
          "enum": [
            "EMIT_BREAK_NO_SILENT_OVERWRITE",
            "RETAIN_SOURCE_ONLY",
            "REQUIRE_LINKAGE_REVIEW"
          ]
        }
      }
    }
  },
  "additionalProperties": false
}
