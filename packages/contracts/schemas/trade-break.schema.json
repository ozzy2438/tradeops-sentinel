{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade-break.schema.json",
  "title": "Deterministic FX trade break",
  "description": "An evidence-bearing deterministic trade-break symptom. It cannot be created, prioritised, or resolved by free-form model output.",
  "$defs": {
    "breakFieldPath": {
      "type": "string",
      "pattern": "^/(payload|linkage)/[a-z][a-z0-9_/-]*$"
    },
    "breakEvidenceRole": {
      "$ref": "break-taxonomy.schema.json#/$defs/evidenceRole"
    },
    "breakFamily": {
      "$ref": "break-taxonomy.schema.json#/$defs/breakFamily"
    },
    "conditionCode": {
      "$ref": "break-taxonomy.schema.json#/$defs/conditionCode"
    },
    "severity": {
      "$ref": "break-taxonomy.schema.json#/$defs/severity"
    },
    "lifecycleState": {
      "$ref": "break-taxonomy.schema.json#/$defs/lifecycleState"
    },
    "transitionReason": {
      "$ref": "break-taxonomy.schema.json#/$defs/transitionReason"
    },
    "observationKind": {
      "$ref": "common.schema.json#/$defs/observationKind"
    },
    "productType": {
      "$ref": "common.schema.json#/$defs/productType"
    },
    "missingSourceExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_observation_kind",
        "expected_source_system",
        "field_path",
        "arrival_window_rule_version",
        "watermark_at",
        "expected_by"
      ],
      "properties": {
        "expected_observation_kind": {
          "enum": ["EXECUTION", "CONFIRMATION", "BOOKING"]
        },
        "expected_source_system": {"$ref": "common.schema.json#/$defs/sourceSystem"},
        "field_path": {"$ref": "#/$defs/breakFieldPath"},
        "arrival_window_rule_version": {"const": "1.0.0"},
        "watermark_at": {"$ref": "common.schema.json#/$defs/timestamp"},
        "expected_by": {"$ref": "common.schema.json#/$defs/timestamp"}
      },
      "oneOf": [
        {
          "properties": {
            "expected_observation_kind": {"const": "EXECUTION"},
            "expected_source_system": {"const": "FIX_EXECUTION"},
            "field_path": {"const": "/payload/execution_status"}
          }
        },
        {
          "properties": {
            "expected_observation_kind": {"const": "CONFIRMATION"},
            "expected_source_system": {"const": "FPML_CONFIRMATION"},
            "field_path": {"const": "/payload/confirmation_status"}
          }
        },
        {
          "properties": {
            "expected_observation_kind": {"const": "BOOKING"},
            "expected_source_system": {"const": "MOCK_LEGACY_BOOKING"},
            "field_path": {"const": "/payload/booking_status"}
          }
        }
      ]
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_observation_id",
        "observation_kind",
        "source_system",
        "source_tenant_id",
        "source_portfolio_id",
        "source_version",
        "content_hash"
      ],
      "properties": {
        "source_observation_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "observation_kind": {"$ref": "common.schema.json#/$defs/observationKind"},
        "source_system": {"$ref": "common.schema.json#/$defs/sourceSystem"},
        "source_tenant_id": {"$ref": "common.schema.json#/$defs/tenantId"},
        "source_portfolio_id": {"$ref": "common.schema.json#/$defs/portfolioId"},
        "source_version": {"$ref": "common.schema.json#/$defs/sourceVersion"},
        "content_hash": {"$ref": "common.schema.json#/$defs/sha256"}
      },
      "oneOf": [
        {"properties": {"observation_kind": {"const": "EXECUTION"}, "source_system": {"const": "FIX_EXECUTION"}}},
        {"properties": {"observation_kind": {"const": "TRADE_CAPTURE"}, "source_system": {"const": "FIX_TRADE_CAPTURE"}}},
        {"properties": {"observation_kind": {"const": "CONFIRMATION"}, "source_system": {"const": "FPML_CONFIRMATION"}}},
        {"properties": {"observation_kind": {"const": "BOOKING"}, "source_system": {"const": "MOCK_LEGACY_BOOKING"}}}
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "role", "content_hash", "captured_at", "source_observation_id", "source_version", "field_path"],
      "properties": {
        "evidence_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "role": {"$ref": "#/$defs/breakEvidenceRole"},
        "content_hash": {"$ref": "common.schema.json#/$defs/sha256"},
        "captured_at": {"$ref": "common.schema.json#/$defs/timestamp"},
        "source_observation_id": {"anyOf": [{"$ref": "common.schema.json#/$defs/identifier"}, {"type": "null"}]},
        "source_version": {"anyOf": [{"$ref": "common.schema.json#/$defs/sourceVersion"}, {"type": "null"}]},
        "field_path": {"anyOf": [{"$ref": "#/$defs/breakFieldPath"}, {"type": "null"}]}
      }
    },
    "tolerance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "value"],
      "properties": {
        "mode": {"enum": ["NONE", "ABSOLUTE_DECIMAL", "RELATIVE_DECIMAL"]},
        "value": {
          "anyOf": [
            {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
            {"type": "null"}
          ]
        }
      },
      "oneOf": [
        {"properties": {"mode": {"const": "NONE"}, "value": {"type": "null"}}},
        {"properties": {"mode": {"enum": ["ABSOLUTE_DECIMAL", "RELATIVE_DECIMAL"]}, "value": {"type": "string"}}}
      ]
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_path", "value_type", "expected_value", "observed_value", "tolerance", "normalisation_rule_version", "evidence_ids"],
      "properties": {
        "field_path": {"$ref": "#/$defs/breakFieldPath"},
        "value_type": {"enum": ["ABSENCE", "COUNT", "CURRENCY_PAIR", "SIDE", "DECIMAL", "DATE", "LIFECYCLE_STATUS", "READBACK", "SOURCE_IDENTITY"]},
        "expected_value": {"type": "string", "minLength": 1},
        "observed_value": {"type": "string", "minLength": 1},
        "tolerance": {"$ref": "#/$defs/tolerance"},
        "normalisation_rule_version": {"const": "1.0.0"},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/identifier"}}
      }
    },
    "priority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["materiality_band", "deadline_status", "case_age_seconds", "ordering_key"],
      "properties": {
        "materiality_band": {"enum": ["MATERIAL", "UNASSESSED", "NON_MATERIAL"]},
        "deadline_status": {"enum": ["OVERDUE", "DUE", "NO_CONFIGURED_DEADLINE"]},
        "case_age_seconds": {"type": "integer", "minimum": 0},
        "ordering_key": {
          "type": "array",
          "prefixItems": [
            {"type": "integer"},
            {"type": "integer"},
            {"type": "integer"},
            {"type": "integer"}
          ],
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "actor": {
      "$ref": "common.schema.json#/$defs/actor"
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolution_type", "reconciliation_run_id", "disposition_id", "approver", "evidence_ids", "evidence_roles"],
      "properties": {
        "resolution_type": {"enum": ["RECONCILIATION_PASS", "OWNER_APPROVED_NON_ACTION"]},
        "reconciliation_run_id": {"anyOf": [{"$ref": "common.schema.json#/$defs/identifier"}, {"type": "null"}]},
        "disposition_id": {"anyOf": [{"$ref": "common.schema.json#/$defs/identifier"}, {"type": "null"}]},
        "approver": {"anyOf": [{"$ref": "#/$defs/actor"}, {"type": "null"}]},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/identifier"}},
        "evidence_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/breakEvidenceRole"}}
      },
      "oneOf": [
        {
          "properties": {
            "resolution_type": {"const": "RECONCILIATION_PASS"},
            "reconciliation_run_id": {"type": "string"},
            "disposition_id": {"type": "null"},
            "approver": {"type": "null"},
            "evidence_roles": {"contains": {"const": "RECONCILIATION_RESULT"}}
          }
        },
        {
          "properties": {
            "resolution_type": {"const": "OWNER_APPROVED_NON_ACTION"},
            "reconciliation_run_id": {"type": "null"},
            "disposition_id": {"type": "string"},
            "approver": {"type": "object", "properties": {"identity_type": {"const": "HUMAN"}}, "required": ["identity_type"]},
            "evidence_roles": {"contains": {"const": "DISPOSITION_APPROVAL"}}
          }
        }
      ]
    }
    ,"reconciliationResolution": {
      "allOf": [
        {"$ref": "#/$defs/resolution"},
        {"properties": {"resolution_type": {"const": "RECONCILIATION_PASS"}}}
      ]
    },
    "ownerApprovedNonActionResolution": {
      "allOf": [
        {"$ref": "#/$defs/resolution"},
        {"properties": {"resolution_type": {"const": "OWNER_APPROVED_NON_ACTION"}}}
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "taxonomy_version",
    "detection_rule_version",
    "priority_rule_version",
    "lifecycle_rule_version",
    "break_id",
    "break_version",
    "tenant_id",
    "portfolio_id",
    "correlation_id",
    "trade_id",
    "canonical_state_version",
    "reconciliation_run_id",
    "product_type",
    "family",
    "condition_code",
    "severity",
    "severity_context",
    "priority",
    "source_version_set",
    "evaluated_field_paths",
    "comparisons",
    "evidence",
    "missing_source_expectation",
    "state",
    "previous_state",
    "transition_reason",
    "detected_at",
    "state_changed_at",
    "resolved_at",
    "resolution",
    "supersedes_break_id",
    "causal_label_id"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "taxonomy_version": {"const": "1.0.0"},
    "detection_rule_version": {"const": "1.0.0"},
    "priority_rule_version": {"const": "1.0.0"},
    "lifecycle_rule_version": {"const": "1.0.0"},
    "break_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "break_version": {"type": "integer", "minimum": 1},
    "tenant_id": {"$ref": "common.schema.json#/$defs/tenantId"},
    "portfolio_id": {"$ref": "common.schema.json#/$defs/portfolioId"},
    "correlation_id": {"$ref": "common.schema.json#/$defs/correlationId"},
    "trade_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "canonical_state_version": {"type": "integer", "minimum": 1},
    "reconciliation_run_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "product_type": {"$ref": "#/$defs/productType"},
    "family": {"$ref": "#/$defs/breakFamily"},
    "condition_code": {"$ref": "#/$defs/conditionCode"},
    "severity": {"$ref": "#/$defs/severity"},
    "severity_context": {"anyOf": [{"$ref": "#/$defs/observationKind"}, {"type": "null"}]},
    "priority": {"$ref": "#/$defs/priority"},
    "source_version_set": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sourceReference"}},
    "evaluated_field_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/breakFieldPath"}},
    "comparisons": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/comparison"}},
    "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}},
    "missing_source_expectation": {"anyOf": [{"$ref": "#/$defs/missingSourceExpectation"}, {"type": "null"}]},
    "state": {"$ref": "#/$defs/lifecycleState"},
    "previous_state": {"anyOf": [{"$ref": "#/$defs/lifecycleState"}, {"type": "null"}]},
    "transition_reason": {"$ref": "#/$defs/transitionReason"},
    "detected_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "state_changed_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "resolved_at": {"anyOf": [{"$ref": "common.schema.json#/$defs/timestamp"}, {"type": "null"}]},
    "resolution": {"anyOf": [{"$ref": "#/$defs/resolution"}, {"type": "null"}]},
    "supersedes_break_id": {"anyOf": [{"$ref": "common.schema.json#/$defs/identifier"}, {"type": "null"}]},
    "causal_label_id": {"anyOf": [{"$ref": "common.schema.json#/$defs/identifier"}, {"type": "null"}]}
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "family": {"const": "MISSING_REQUIRED_SOURCE"},
            "condition_code": {"const": "MISSING_SOURCE_AFTER_WATERMARK"},
            "severity": {"const": "MEDIUM"},
            "severity_context": {"const": "CONFIRMATION"},
            "missing_source_expectation": {"$ref": "#/$defs/missingSourceExpectation"},
            "comparisons": {"items": {"properties": {"field_path": {"const": "/payload/confirmation_status"}, "value_type": {"const": "ABSENCE"}}}},
            "resolution": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/reconciliationResolution"}, {"$ref": "#/$defs/ownerApprovedNonActionResolution"}]},
            "evidence": {"allOf": [{"contains": {"properties": {"role": {"const": "INGESTION_WATERMARK"}}, "required": ["role"]}}, {"contains": {"properties": {"role": {"const": "EXPECTED_SOURCE"}}, "required": ["role"]}}]}
          }
        },
        {
          "properties": {
            "family": {"const": "MISSING_REQUIRED_SOURCE"},
            "condition_code": {"const": "MISSING_SOURCE_AFTER_WATERMARK"},
            "severity": {"const": "HIGH"},
            "severity_context": {"enum": ["EXECUTION", "BOOKING"]},
            "missing_source_expectation": {"$ref": "#/$defs/missingSourceExpectation"},
            "comparisons": {"items": {"oneOf": [
              {"properties": {"field_path": {"const": "/payload/execution_status"}, "value_type": {"const": "ABSENCE"}}},
              {"properties": {"field_path": {"const": "/payload/booking_status"}, "value_type": {"const": "ABSENCE"}}}
            ]}},
            "resolution": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/reconciliationResolution"}, {"$ref": "#/$defs/ownerApprovedNonActionResolution"}]},
            "evidence": {"allOf": [{"contains": {"properties": {"role": {"const": "INGESTION_WATERMARK"}}, "required": ["role"]}}, {"contains": {"properties": {"role": {"const": "EXPECTED_SOURCE"}}, "required": ["role"]}}]}
          }
        },
        {
          "properties": {
            "family": {"const": "AMBIGUOUS_OR_UNMATCHED_LINKAGE"},
            "condition_code": {"const": "LINKAGE_CANDIDATE_SCOPE_INVARIANT"},
            "severity": {"const": "HIGH"},
            "severity_context": {"type": "null"},
            "missing_source_expectation": {"type": "null"},
            "comparisons": {"items": {"properties": {"field_path": {"const": "/linkage/trade_id"}, "value_type": {"const": "COUNT"}}}},
            "resolution": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/reconciliationResolution"}]},
            "evidence": {"allOf": [{"contains": {"properties": {"role": {"const": "CANDIDATE_LINK"}}, "required": ["role"]}}, {"contains": {"properties": {"role": {"const": "LINKAGE_DECISION"}}, "required": ["role"]}}]}
          }
        },
        {
          "properties": {
            "family": {"const": "DUPLICATE_SOURCE_CONFLICT"},
            "condition_code": {"const": "DUPLICATE_SOURCE_IDENTITY_CONTENT"},
            "severity": {"const": "HIGH"},
            "severity_context": {"type": "null"},
            "missing_source_expectation": {"type": "null"},
            "comparisons": {"items": {"oneOf": [
              {"properties": {"field_path": {"const": "/payload/source_business_key"}, "value_type": {"const": "SOURCE_IDENTITY"}}},
              {"properties": {"field_path": {"const": "/payload/source_version"}, "value_type": {"const": "SOURCE_IDENTITY"}}},
              {"properties": {"field_path": {"const": "/payload/content_hash"}, "value_type": {"const": "SOURCE_IDENTITY"}}}
            ]}},
            "resolution": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/reconciliationResolution"}]},
            "evidence": {"allOf": [{"contains": {"properties": {"role": {"const": "SOURCE_PAYLOAD_PAIR"}}, "required": ["role"]}}, {"contains": {"properties": {"role": {"const": "SOURCE_METADATA"}}, "required": ["role"]}}]}
          }
        },
        {
          "properties": {
            "family": {"const": "CURRENCY_PAIR_OR_SIDE_MISMATCH"},
            "condition_code": {"const": "EXACT_CURRENCY_PAIR_SIDE"},
            "severity": {"const": "CRITICAL"},
            "severity_context": {"type": "null"},
            "missing_source_expectation": {"type": "null"},
            "comparisons": {"items": {"oneOf": [
              {"properties": {"field_path": {"const": "/payload/currency_pair"}, "value_type": {"const": "CURRENCY_PAIR"}}},
              {"properties": {"field_path": {"const": "/payload/side"}, "value_type": {"const": "SIDE"}}}
            ]}},
            "resolution": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/reconciliationResolution"}]},
            "evidence": {"allOf": [{"contains": {"properties": {"role": {"const": "FIELD_COMPARISON"}}, "required": ["role"]}}, {"contains": {"properties": {"role": {"const": "NORMALISATION_RULE"}}, "required": ["role"]}}]}
          }
        },
        {
          "properties": {
            "family": {"const": "ECONOMIC_VALUE_MISMATCH"},
            "condition_code": {"const": "DECIMAL_OUTSIDE_TOLERANCE"},
            "severity": {"const": "CRITICAL"},
            "severity_context": {"type": "null"},
            "missing_source_expectation": {"type": "null"},
            "comparisons": {"items": {"oneOf": [
              {"properties": {"field_path": {"const": "/payload/base_amount"}, "value_type": {"const": "DECIMAL"}}},
              {"properties": {"field_path": {"const": "/payload/terms_amount"}, "value_type": {"const": "DECIMAL"}}},
              {"properties": {"field_path": {"const": "/payload/quoted_rate"}, "value_type": {"const": "DECIMAL"}}}
            ]}},
            "resolution": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/reconciliationResolution"}]},
            "evidence": {"allOf": [{"contains": {"properties": {"role": {"const": "DECIMAL_COMPARISON"}}, "required": ["role"]}}, {"contains": {"properties": {"role": {"const": "NORMALISATION_RULE"}}, "required": ["role"]}}]}
          }
        },
        {
          "properties": {
            "family": {"const": "TRADE_OR_VALUE_DATE_MISMATCH"},
            "condition_code": {"const": "EXACT_TRADE_VALUE_DATE"},
            "severity": {"const": "HIGH"},
            "severity_context": {"type": "null"},
            "missing_source_expectation": {"type": "null"},
            "comparisons": {"items": {"oneOf": [
              {"properties": {"field_path": {"const": "/payload/trade_date"}, "value_type": {"const": "DATE"}}},
              {"properties": {"field_path": {"const": "/payload/value_date"}, "value_type": {"const": "DATE"}}}
            ]}},
            "resolution": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/reconciliationResolution"}]},
            "evidence": {"allOf": [{"contains": {"properties": {"role": {"const": "DATE_COMPARISON"}}, "required": ["role"]}}, {"contains": {"properties": {"role": {"const": "NORMALISATION_RULE"}}, "required": ["role"]}}]}
          }
        },
        {
          "properties": {
            "family": {"const": "LIFECYCLE_STATUS_MISMATCH"},
            "condition_code": {"const": "ALLOWED_LIFECYCLE_RELATION"},
            "severity": {"const": "HIGH"},
            "severity_context": {"type": "null"},
            "missing_source_expectation": {"type": "null"},
            "comparisons": {"items": {"properties": {"field_path": {"const": "/payload/lifecycle_status"}, "value_type": {"const": "LIFECYCLE_STATUS"}}}},
            "resolution": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/reconciliationResolution"}]},
            "evidence": {"allOf": [{"contains": {"properties": {"role": {"const": "LIFECYCLE_RELATION"}}, "required": ["role"]}}, {"contains": {"properties": {"role": {"const": "NORMALISATION_RULE"}}, "required": ["role"]}}]}
          }
        },
        {
          "properties": {
            "family": {"const": "POST_ACTION_VERIFICATION_FAILURE"},
            "condition_code": {"const": "POST_ACTION_READBACK_RECONCILIATION"},
            "severity": {"const": "CRITICAL"},
            "severity_context": {"type": "null"},
            "missing_source_expectation": {"type": "null"},
            "comparisons": {"items": {"oneOf": [
              {"properties": {"field_path": {"const": "/payload/action_target"}, "value_type": {"const": "READBACK"}}},
              {"properties": {"field_path": {"const": "/payload/action_status"}, "value_type": {"const": "READBACK"}}},
              {"properties": {"field_path": {"const": "/payload/book_id"}, "value_type": {"const": "READBACK"}}}
            ]}},
            "resolution": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/reconciliationResolution"}, {"$ref": "#/$defs/ownerApprovedNonActionResolution"}]},
            "evidence": {"allOf": [{"contains": {"properties": {"role": {"const": "ACTION_INSTRUCTION"}}, "required": ["role"]}}, {"contains": {"properties": {"role": {"const": "PRE_ACTION_READ"}}, "required": ["role"]}}, {"contains": {"properties": {"role": {"const": "POST_ACTION_READ"}}, "required": ["role"]}}, {"contains": {"properties": {"role": {"const": "CHANGED_FIELD_DIFF"}}, "required": ["role"]}}, {"contains": {"properties": {"role": {"const": "RECONCILIATION_RESULT"}}, "required": ["role"]}}]}
          }
        }
      ]
    },
    {
      "oneOf": [
        {"properties": {"previous_state": {"type": "null"}, "state": {"const": "OPEN"}, "transition_reason": {"const": "DETECTED"}, "resolved_at": {"type": "null"}, "resolution": {"type": "null"}}},
        {"properties": {"previous_state": {"const": "OPEN"}, "state": {"const": "UNDER_INVESTIGATION"}, "transition_reason": {"const": "BEGIN_INVESTIGATION"}, "resolved_at": {"type": "null"}, "resolution": {"type": "null"}}},
        {"properties": {"previous_state": {"const": "OPEN"}, "state": {"const": "ESCALATED"}, "transition_reason": {"const": "ESCALATE"}, "resolved_at": {"type": "null"}, "resolution": {"type": "null"}}},
        {"properties": {"previous_state": {"const": "UNDER_INVESTIGATION"}, "state": {"const": "RESOLUTION_PROPOSED"}, "transition_reason": {"const": "PROPOSE_RESOLUTION"}, "resolved_at": {"type": "null"}, "resolution": {"type": "null"}}},
        {"properties": {"previous_state": {"const": "UNDER_INVESTIGATION"}, "state": {"const": "ESCALATED"}, "transition_reason": {"const": "ESCALATE"}, "resolved_at": {"type": "null"}, "resolution": {"type": "null"}}},
        {"properties": {"previous_state": {"const": "RESOLUTION_PROPOSED"}, "state": {"const": "ACTION_PENDING"}, "transition_reason": {"const": "ACTION_AUTHORISATION_PENDING"}, "resolved_at": {"type": "null"}, "resolution": {"type": "null"}}},
        {"properties": {"previous_state": {"const": "RESOLUTION_PROPOSED"}, "state": {"const": "NO_ACTION_DISPOSITION_PENDING"}, "transition_reason": {"const": "NO_ACTION_DISPOSITION_PENDING"}, "resolved_at": {"type": "null"}, "resolution": {"type": "null"}}},
        {"properties": {"previous_state": {"const": "RESOLUTION_PROPOSED"}, "state": {"const": "ESCALATED"}, "transition_reason": {"const": "ESCALATE"}, "resolved_at": {"type": "null"}, "resolution": {"type": "null"}}},
