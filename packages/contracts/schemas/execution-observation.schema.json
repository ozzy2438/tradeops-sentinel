{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution-observation.schema.json",
  "title": "FIX-style execution observation",
  "description": "One execution event/version. It is distinct from trade capture, confirmation and booking observations.",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/observationEnvelope"
    },
    {
      "type": "object",
      "required": ["payload"],
      "properties": {
        "observation_kind": {
          "const": "EXECUTION"
        },
        "source_system": {
          "const": "FIX_EXECUTION"
        },
        "payload": {
          "allOf": [
            {
              "$ref": "common.schema.json#/$defs/fxPayload"
            },
            {
              "type": "object",
              "required": [
                "execution_id",
                "execution_type",
                "execution_status",
                "execution_time"
              ],
              "properties": {
                "execution_id": {
                  "$ref": "common.schema.json#/$defs/identifier"
                },
                "execution_type": {
                  "enum": ["NEW", "AMEND", "CANCEL"]
                },
                "execution_status": {
                  "enum": ["EXECUTED", "AMENDED", "CANCELLED"]
                },
                "execution_time": {
                  "$ref": "common.schema.json#/$defs/timestamp"
                },
                "order_id": {
                  "$ref": "common.schema.json#/$defs/identifier"
                }
              }
            },
            {
              "allOf": [
                {
                  "if": {"properties": {"execution_type": {"const": "NEW"}}},
                  "then": {"properties": {"execution_status": {"const": "EXECUTED"}, "lifecycle_status": {"const": "NEW"}}}
                },
                {
                  "if": {"properties": {"execution_type": {"const": "AMEND"}}},
                  "then": {"properties": {"execution_status": {"const": "AMENDED"}, "lifecycle_status": {"const": "AMENDED"}}}
                },
                {
                  "if": {"properties": {"execution_type": {"const": "CANCEL"}}},
                  "then": {"properties": {"execution_status": {"const": "CANCELLED"}, "lifecycle_status": {"const": "CANCELLED"}}}
                }
              ]
            }
          ],
          "unevaluatedProperties": false
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
