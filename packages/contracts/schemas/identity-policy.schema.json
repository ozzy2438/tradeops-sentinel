{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "identity-policy.schema.json",
  "title": "Source observation identity, replay and conflict policy",
  "description": "Machine-readable decision table for source identity, transport replay, source-version supersession and fail-closed linkage outcomes.",
  "type": "object",
  "required": ["policy_version", "source_identity_fields", "source_version_field", "delivery_identity_fields", "outcomes"],
  "properties": {
    "policy_version": {
      "$ref": "common.schema.json#/$defs/semanticVersion"
    },
    "source_identity_fields": {
      "const": [
        "tenant_id",
        "portfolio_id",
        "source_system",
        "observation_kind",
        "source_business_key"
      ]
    },
    "source_version_field": {
      "const": "source_version"
    },
    "delivery_identity_fields": {
      "const": ["source_system", "source_event_id"]
    },
    "content_hash_field": {
      "const": "content_hash"
    },
    "outcomes": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["precedence", "case_id", "condition", "outcome", "storage_effect", "canonical_effect"],
        "properties": {
          "precedence": {
            "type": "integer",
            "minimum": 1
          },
          "case_id": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "condition": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description"],
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "same_delivery_identity": {
                "type": "boolean"
              },
              "same_source_identity": {
                "type": "boolean"
              },
              "same_content_hash": {
                "type": "boolean"
              },
              "source_version_relation": {
                "enum": ["SAME", "GREATER", "LOWER", "NOT_APPLICABLE"]
              },
              "scope_match": {
                "type": "boolean"
              },
              "schema_version_supported": {
                "type": "boolean"
              }
            }
          },
          "outcome": {
            "enum": [
              "NEW_OBSERVATION",
              "IDEMPOTENT_REPLAY",
              "DUPLICATE_SOURCE_CONFLICT",
              "NEW_SOURCE_VERSION",
              "LATE_SOURCE_VERSION_RECORDED",
              "REJECT_UNSUPPORTED_SCHEMA_VERSION",
              "REJECT_CROSS_PORTFOLIO_LINKAGE",
              "LINKAGE_REVIEW_REQUIRED"
            ]
          },
          "storage_effect": {
            "enum": [
              "APPEND",
              "APPEND_DUPLICATE_EVIDENCE",
              "APPEND_CONFLICT_EVIDENCE",
              "APPEND_AND_SUPERSEDE_ACTIVE_VERSION",
              "APPEND_LATE_NON_ACTIVE_VERSION",
              "REJECT"
            ]
          },
          "canonical_effect": {
            "enum": [
              "CREATE_PROJECTION_CANDIDATE",
              "NO_CHANGE",
              "RECONCILE_NEW_SOURCE_SET",
              "DO_NOT_POPULATE_AUTHORITATIVE_FIELDS",
              "REQUIRE_LINKAGE_REVIEW"
            ]
          }
        },
        "oneOf": [
          {
            "properties": {
              "outcome": {"const": "NEW_OBSERVATION"},
              "condition": {
                "type": "object",
                "additionalProperties": false,
                "required": ["description", "same_delivery_identity", "same_source_identity"],
                "properties": {
                  "description": {"type": "string", "minLength": 1},
                  "same_delivery_identity": {"const": false},
                  "same_source_identity": {"const": false}
                }
              },
              "storage_effect": {"const": "APPEND"},
              "canonical_effect": {"const": "CREATE_PROJECTION_CANDIDATE"}
            }
          },
          {
            "properties": {
              "outcome": {"const": "IDEMPOTENT_REPLAY"},
              "condition": {
                "type": "object",
                "additionalProperties": false,
                "required": ["description", "same_delivery_identity", "same_content_hash"],
                "properties": {
                  "description": {"type": "string", "minLength": 1},
                  "same_delivery_identity": {"const": true},
                  "same_content_hash": {"const": true}
                }
              },
              "storage_effect": {"const": "APPEND_DUPLICATE_EVIDENCE"},
              "canonical_effect": {"const": "NO_CHANGE"}
            }
          },
          {
            "properties": {
              "outcome": {"const": "DUPLICATE_SOURCE_CONFLICT"},
              "condition": {
                "type": "object",
                "additionalProperties": false,
                "required": ["description", "same_delivery_identity", "same_content_hash"],
                "properties": {
                  "description": {"type": "string", "minLength": 1},
                  "same_delivery_identity": {"const": true},
                  "same_content_hash": {"const": false}
                }
              },
              "storage_effect": {"const": "APPEND_CONFLICT_EVIDENCE"},
              "canonical_effect": {"const": "REQUIRE_LINKAGE_REVIEW"}
            }
          },
          {
            "properties": {
              "outcome": {"const": "NEW_SOURCE_VERSION"},
              "condition": {
                "type": "object",
                "additionalProperties": false,
                "required": ["description", "same_source_identity", "source_version_relation"],
                "properties": {
                  "description": {"type": "string", "minLength": 1},
                  "same_source_identity": {"const": true},
                  "source_version_relation": {"const": "GREATER"}
                }
              },
              "storage_effect": {"const": "APPEND_AND_SUPERSEDE_ACTIVE_VERSION"},
              "canonical_effect": {"const": "RECONCILE_NEW_SOURCE_SET"}
            }
          },
          {
            "properties": {
              "outcome": {"const": "LATE_SOURCE_VERSION_RECORDED"},
              "condition": {
                "type": "object",
                "additionalProperties": false,
                "required": ["description", "same_source_identity", "source_version_relation"],
                "properties": {
                  "description": {"type": "string", "minLength": 1},
                  "same_source_identity": {"const": true},
                  "source_version_relation": {"const": "LOWER"}
                }
              },
              "storage_effect": {"const": "APPEND_LATE_NON_ACTIVE_VERSION"},
              "canonical_effect": {"const": "NO_CHANGE"}
            }
          },
          {
            "properties": {
              "outcome": {"const": "REJECT_UNSUPPORTED_SCHEMA_VERSION"},
              "condition": {
                "type": "object",
                "additionalProperties": false,
                "required": ["description", "schema_version_supported"],
                "properties": {
                  "description": {"type": "string", "minLength": 1},
                  "schema_version_supported": {"const": false}
                }
              },
              "storage_effect": {"const": "REJECT"},
              "canonical_effect": {"const": "DO_NOT_POPULATE_AUTHORITATIVE_FIELDS"}
            }
          },
          {
            "properties": {
              "outcome": {"const": "REJECT_CROSS_PORTFOLIO_LINKAGE"},
              "condition": {
                "type": "object",
                "additionalProperties": false,
                "required": ["description", "scope_match"],
                "properties": {
                  "description": {"type": "string", "minLength": 1},
                  "scope_match": {"const": false}
                }
              },
              "storage_effect": {"const": "REJECT"},
              "canonical_effect": {"const": "DO_NOT_POPULATE_AUTHORITATIVE_FIELDS"}
            }
          },
          {
            "properties": {
              "outcome": {"const": "LINKAGE_REVIEW_REQUIRED"},
              "condition": {
                "type": "object",
                "additionalProperties": false,
                "required": ["description", "scope_match"],
                "properties": {
                  "description": {"type": "string", "minLength": 1},
                  "scope_match": {"const": true}
                }
              },
              "storage_effect": {"const": "APPEND"},
              "canonical_effect": {"const": "REQUIRE_LINKAGE_REVIEW"}
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
