# TradeOps Sentinel — environment variable NAMES only.
# Never commit real values. Copy to .env and fill in locally.

# Neon PostgreSQL connection string for the tradeops-dev branch.
# Format: postgresql://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=

# Shared secret required by every authenticated API endpoint.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TRADEOPS_API_KEY=

# Required before an approved remediation action can be signed and executed.
# Generate independently from TRADEOPS_API_KEY.
TRADEOPS_REMEDIATION_SIGNING_SECRET=

# Public base URL used only to construct short-lived attended UiPath launch
# links. Keep localhost for the local Community demo.
TRADEOPS_UIPATH_BASE_URL=http://127.0.0.1:8000

# AI provider: deterministic (default), azure_openai, or anthropic.
TRADEOPS_AI_PROVIDER=deterministic

# Azure OpenAI (required only when TRADEOPS_AI_PROVIDER=azure_openai).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_MAX_COMPLETION_TOKENS=400
AZURE_OPENAI_REASONING_EFFORT=minimal
# Optional alternative to Microsoft Entra / DefaultAzureCredential.
AZURE_OPENAI_API_KEY=

# Dashboard -> API base URL (compose sets this automatically).
API_BASE_URL=http://localhost:8000

# Optional
LOG_LEVEL=INFO
TRADEOPS_AUTO_MIGRATE=true
